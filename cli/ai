#!/usr/bin/env python3
"""Minimal, fast terminal AI assistant backed by local Ollama."""

import json
import os
import re
import secrets
import signal
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
from pathlib import Path

try:
    import readline  # Arrow keys & history in terminal
except ImportError:
    pass

# --- CONFIG ---
BASE_DIR = Path(__file__).resolve().parent.parent
SOUL_FILE = Path(os.environ.get("AGENT_SOUL", str(BASE_DIR / "soul.md"))).expanduser()
CHATS_DIR = Path(os.environ.get("AGENT_CHATS", str(BASE_DIR / "chats"))).expanduser()
OLLAMA_HOST = os.environ.get("OLLAMA_HOST", "http://127.0.0.1:11434").rstrip("/")
OLLAMA_URL = f"{OLLAMA_HOST}/api/chat"
OLLAMA_TAGS_URL = f"{OLLAMA_HOST}/api/tags"
DEFAULT_MODEL = os.environ.get("AGENT_MODEL", "lfm3")
NUM_CTX = int(os.environ.get("AGENT_CTX", "16384"))
MAX_HISTORY = 16
MAX_HISTORY_CHARS = 28000
MAX_STEPS = 8

USE_COLOR = sys.stdout.isatty()


class C:
    RESET = "\033[0m" if USE_COLOR else ""
    BOLD = "\033[1m" if USE_COLOR else ""
    DIM = "\033[2m" if USE_COLOR else ""
    WHITE = "\033[97m" if USE_COLOR else ""
    RED = "\033[91m" if USE_COLOR else ""
    GREEN = "\033[92m" if USE_COLOR else ""
    YELLOW = "\033[93m" if USE_COLOR else ""
    BLUE = "\033[94m" if USE_COLOR else ""
    MAGENTA = "\033[95m" if USE_COLOR else ""
    CYAN = "\033[96m" if USE_COLOR else ""
    GRAY = "\033[90m" if USE_COLOR else ""


class Spinner:
    """Minimal terminal ASCII progress bar."""

    FRAMES = [
        "[=       ]", "[==      ]", "[===     ]", "[ ===    ]",
        "[  ===   ]", "[   ===  ]", "[    === ]", "[     ===]",
        "[      ==]", "[       =]", "[      ==]", "[     ===]",
        "[    === ]", "[   ===  ]", "[  ===   ]", "[ ===    ]",
        "[===     ]", "[==      ]",
    ]
    RAINBOW = [C.CYAN, C.BLUE, C.MAGENTA, C.GREEN, C.YELLOW]

    def __init__(self, label: str = "thinking", enabled: bool = True):
        self.label = label
        self.enabled = enabled and sys.stdout.isatty()
        self._stop = threading.Event()
        self._thread = None

    def _animate(self):
        start = time.monotonic()
        i = 0
        while not self._stop.is_set():
            frame = self.FRAMES[i % len(self.FRAMES)]
            col = self.RAINBOW[(i // 3) % len(self.RAINBOW)]
            elapsed = time.monotonic() - start
            sys.stdout.write(
                f"\r\033[K  {col}{frame}{C.RESET} "
                f"{C.DIM}{self.label}... {elapsed:.1f}s{C.RESET}"
            )
            sys.stdout.flush()
            i += 1
            self._stop.wait(0.08)

    def __enter__(self):
        if self.enabled:
            sys.stdout.write("\033[?25l")
            sys.stdout.flush()
            self._thread = threading.Thread(target=self._animate, daemon=True)
            self._thread.start()
        return self

    def __exit__(self, exc_type, exc_val, exc_tb):
        if self.enabled:
            self._stop.set()
            if self._thread:
                self._thread.join()
            sys.stdout.write("\r\033[K\033[?25h")
            sys.stdout.flush()


TOOLS_SCHEMA = [
    {
        "type": "function",
        "function": {
            "name": "run_bash",
            "description": (
                "Run a bash command on THIS Linux PC and return stdout/stderr. "
                "Only use when explicitly asked to inspect or act on this local machine."
            ),
            "parameters": {
                "type": "object",
                "properties": {
                    "command": {"type": "string", "description": "The bash command to run"}
                },
                "required": ["command"],
            },
        },
    },
    {
        "type": "function",
        "function": {
            "name": "read_file",
            "description": (
                "Read the contents of a local file on THIS PC. "
                "Only use when explicitly asked to inspect a local file."
            ),
            "parameters": {
                "type": "object",
                "properties": {
                    "path": {"type": "string", "description": "Path to the file"}
                },
                "required": ["path"],
            },
        },
    },
    {
        "type": "function",
        "function": {
            "name": "write_file",
            "description": (
